{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NasaPsi": {
    "BaseUrl": "https://psi.nasa.gov/geode-py/ws/repo/search",
    "DefaultQuery": "combustion",
    "DefaultResearchArea": "Combustion Science",
    "DefaultSize": 150,
    "TimeoutSeconds": 30
  },
  "Data": {
    "NormalizedInvestigationsPath": "data/normalized_investigations.json",
    "CacheTtlMinutes": 0,
    "CacheRefreshCheckMinutes": 15
  },
  "Agent": {
    "Provider": "groq"
  },
  "Groq": {
    "Model": "openai/gpt-oss-120b",
    "MaxToolRounds": 5,
    "TimeoutSeconds": 180
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.1-flash-lite",
    "MaxToolRounds": 5
  },
  "Jev": {
    "BaseUrl": "https://api.typesafe.ai",
    "Model": "jev-latest",
    "TimeoutSeconds": 30
  }
}
