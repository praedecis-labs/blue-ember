{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "http://localhost:3000"
  },
  "NasaPsi": {
    "BaseUrl": "https://psi.nasa.gov/geode-py/ws/repo/search",
    "DefaultQuery": "combustion",
    "DefaultResearchArea": "Combustion Science",
    "DefaultSize": 150,
    "TimeoutSeconds": 30
  },
  "Data": {
    "NormalizedInvestigationsPath": "data/normalized_investigations.json",
    "CacheTtlMinutes": 0,
    "CacheRefreshCheckMinutes": 15
  },
  "Agent": {
    "Provider": "nvidia",
    "Fallbacks": [ "gemini" ]
  },
  "Nvidia": {
    "Model": "nvidia/nemotron-3.5-super-vl-120b-a12b",
    "MaxToolRounds": 5,
    "TimeoutSeconds": 180
  },
  "Gemini": {
    "Model": "gemma-4-31b-it",
    "MaxToolRounds": 5
  },
  "Jev": {
    "BaseUrl": "https://api.typesafe.ai",
    "Model": "jev-latest",
    "TimeoutSeconds": 30
  }
}
